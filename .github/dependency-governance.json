{
  "schemaVersion": 1,
  "botLogin": "dependabot[bot]",
  "botUserId": 49699333,
  "botAuthorEmail": "49699333+dependabot[bot]@users.noreply.github.com",
  "trustedCommitterLogin": "web-flow",
  "gitCommitterName": "GitHub",
  "gitCommitterEmail": "noreply@github.com",
  "signedOffBy": "Signed-off-by: dependabot[bot] <support@github.com>",
  "baseBranch": "main",
  "mergeMethod": "rebase",
  "automergeEnabled": true,
  "statusCommentMarker": "<!-- dependency-governance:v1 -->",
  "maxChangedFiles": 25,
  "maxPullRequestAgeDays": 14,
  "maxPaginationPages": 10,
  "manualReviewLabels": [
    "manual-review",
    "do-not-merge"
  ],
  "requiredWorkflows": [
    {
      "workflow": "ci",
      "gate": "ci-gate",
      "file": "ci.yml"
    },
    {
      "workflow": "extended",
      "gate": "extended-gate",
      "file": "extended.yml"
    },
    {
      "workflow": "security",
      "gate": "security-gate",
      "file": "security.yml"
    },
    {
      "workflow": "docs",
      "gate": "docs-contract",
      "file": "docs.yml"
    }
  ],
  "allowedActionUpdateTypes": [
    "version-update:semver-patch",
    "version-update:semver-minor",
    "security-update:semver-patch",
    "security-update:semver-minor"
  ],
  "manualReviewPaths": [
    ".github/workflows/security.yml",
    ".github/workflows/dependency-governance.yml",
    ".github/dependency-governance.json",
    ".github/scripts/dependency_governance.py",
    ".github/scripts/dependency_governance_selfcheck.py",
    ".github/dependabot.yml"
  ],
  "ecosystems": {
    "nuget": {
      "files": [
        "UiTests.csproj",
        "packages.lock.json"
      ],
      "mode": "manual",
      "reason": "UiTests.csproj co-locates package versions with target-framework, restore-lock, NuGet audit, warnings-as-errors, and package asset-boundary policy, while packages.lock.json is the committed resolved graph. NuGet updates therefore remain human-reviewed instead of being represented as autonomously safe from file scope alone."
    },
    "github-actions": {
      "workflowPrefix": ".github/workflows/",
      "extensions": [
        ".yml",
        ".yaml"
      ]
    }
  }
}
